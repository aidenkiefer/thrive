# Supabase — from Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yqybuerlpzemepufwwea.supabase.co
# New publishable key (Dashboard → Connect → Next.js) OR legacy anon JWT:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Server-only. Never expose to the browser.

# Staff one-time email code sign-in (Supabase Auth + NextAuth website session)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# The Supabase URL, publishable/anon key, and server-only service role key above
# are also required for staff sign-in. Staff users and memberships are
# provisioned in Supabase Auth and admin_staff_accounts, not via environment.
# Configure a code-only Auth email template and SMTP separately in Supabase.
