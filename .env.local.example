# Supabase — from Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yqybuerlpzemepufwwea.supabase.co
# New publishable key (Dashboard → Connect → Next.js) OR legacy anon JWT:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Server-only. Never expose to the browser.

# NextAuth — admin panel authentication
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# If using Google OAuth for admin (requires Google Workspace @thrivevineyard.com accounts)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
