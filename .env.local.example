# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Server-only. Never expose to the browser.

# NextAuth — admin panel authentication
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# If using Google OAuth for admin (requires Google Workspace @thrivevineyard.com accounts)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
